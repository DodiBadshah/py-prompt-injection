# -------------------------------------------------------------------
# py-prompt-injection environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -------------------------------------------------------------------

# --- API Keys -------------------------------------------------------
# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# --- Model Selection ------------------------------------------------
# Default model used when --model flag is not passed to CLI
# Anthropic example: claude-3-5-sonnet-20241022
# OpenAI example:    gpt-4o
DEFAULT_MODEL=claude-3-5-sonnet-20241022
DEFAULT_PROVIDER=anthropic

# --- Test Run Behaviour ---------------------------------------------
# Maximum number of payloads to run in a single session (safety cap)
MAX_PAYLOADS_PER_RUN=100

# Seconds to wait between API calls (rate limit buffer)
REQUEST_DELAY_SECONDS=0.5

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# --- Scoring --------------------------------------------------------
# Minimum score threshold to flag a result as a finding (0.0 to 1.0)
SCORE_THRESHOLD=0.7

# --- Reporting ------------------------------------------------------
# Output directory for generated HTML and PDF reports
REPORT_OUTPUT_DIR=reports/

# --- MLflow ---------------------------------------------------------
# Local tracking by default. Change to a remote URI for team use.
MLFLOW_TRACKING_URI=mlruns/
MLFLOW_EXPERIMENT_NAME=py-prompt-injection