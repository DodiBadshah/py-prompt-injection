<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LLM Probe Report</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; margin: 40px; color: #1a1a2e; background: #f5f5f5; }
    h1 { color: #16213e; margin-bottom: 16px; }

    .summary {
      background: #16213e;
      color: white;
      padding: 16px 24px;
      border-radius: 8px;
      margin-bottom: 32px;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
    }
    .summary span { font-size: 1.0em; }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      table-layout: fixed;
    }

    th {
      background: #16213e;
      color: white;
      padding: 12px 16px;
      text-align: left;
      font-size: 0.88em;
      font-weight: 600;
    }

    td {
      padding: 12px 16px;
      border-bottom: 1px solid #e8e8e8;
      font-size: 0.86em;
      vertical-align: top;
      word-wrap: break-word;
      overflow-wrap: break-word;
      line-height: 1.5;
    }

    tr.pass { background: #f0fff4; }
    tr.fail { background: #fff5f5; }
    tr:last-child td { border-bottom: none; }

    .badge {
      display: inline-block;
      padding: 3px 12px;
      border-radius: 12px;
      font-weight: bold;
      font-size: 0.85em;
    }
    .badge.pass { background: #c6f6d5; color: #276749; }
    .badge.fail { background: #fed7d7; color: #9b2c2c; }

    .score { font-weight: bold; }

    .flags { font-size: 0.86em; color: #1a1a2e; line-height: 1.6; }
    
    /* Column widths */
    th:nth-child(1), td:nth-child(1) { width: 95px; }
    th:nth-child(2), td:nth-child(2) { width: 140px; }
    th:nth-child(3), td:nth-child(3) { width: 90px; }
    th:nth-child(4), td:nth-child(4) { width: 80px; }
    th:nth-child(5), td:nth-child(5) { width: 55px; }
    th:nth-child(6), td:nth-child(6) { width: auto; }
    th:nth-child(7), td:nth-child(7) { width: 200px; }

    footer { margin-top: 32px; color: #888; font-size: 0.8em; }
  </style>
</head>
<body>
  <h1>LLM Probe Security Report</h1>
  <div class="summary">
    <span>Model: <strong>{{ model }}</strong></span>
    <span>Total: <strong>{{ total }}</strong></span>
    <span>Passed: <strong>{{ passed }}</strong></span>
    <span>Failed: <strong>{{ failed }}</strong></span>
    <span>Pass Rate: <strong>{{ pass_rate }}%</strong></span>
    <span>Generated: <strong>{{ generated_at }}</strong></span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Payload ID</th>
        <th>Category</th>
        <th>Severity</th>
        <th>Verdict</th>
        <th>Score</th>
        <th>Model Response</th>
        <th>Flags</th>
      </tr>
    </thead>
    <tbody>
      {% for r in results %}
      <tr class="{{ 'pass' if r.passed else 'fail' }}">
        <td>{{ r.payload_id }}</td>
        <td>{{ r.category }}</td>
        <td>{{ r.severity }}</td>
        <td><span class="badge {{ 'pass' if r.passed else 'fail' }}">{{ 'PASS' if r.passed else 'FAIL' }}</span></td>
        <td class="score">{{ r.score }}</td>
        <td>{{ r.raw_response[:400] }}{% if r.raw_response|length > 400 %}...{% endif %}</td>
        <td><div class="flags">{{ r.flags | join('<br>') if r.flags else 'none' }}</div></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <footer>Generated by py-prompt-injection | Phase 1</footer>
</body>
</html>
