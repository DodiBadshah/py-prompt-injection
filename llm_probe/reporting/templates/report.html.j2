<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LLM Probe Report</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; color: #1a1a2e; background: #f5f5f5; }
    h1 { color: #16213e; }
    .summary { background: #16213e; color: white; padding: 16px 24px; border-radius: 8px; margin-bottom: 32px; }
    .summary span { margin-right: 32px; font-size: 1.1em; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    th { background: #16213e; color: white; padding: 12px 16px; text-align: left; font-size: 0.9em; }
    td { padding: 10px 16px; border-bottom: 1px solid #e8e8e8; font-size: 0.88em; vertical-align: top; }
    tr.pass { background: #f0fff4; }
    tr.fail { background: #fff5f5; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-weight: bold; font-size: 0.85em; }
    .badge.pass { background: #c6f6d5; color: #276749; }
    .badge.fail { background: #fed7d7; color: #9b2c2c; }
    .response { max-width: 400px; word-break: break-word; }
    .score { font-weight: bold; }
    footer { margin-top: 32px; color: #888; font-size: 0.8em; }
  </style>
</head>
<body>
  <h1>LLM Probe Security Report</h1>
  <div class="summary">
    <span>Model: <strong>{{ model }}</strong></span>
    <span>Total: <strong>{{ total }}</strong></span>
    <span>Passed: <strong>{{ passed }}</strong></span>
    <span>Failed: <strong>{{ failed }}</strong></span>
    <span>Pass Rate: <strong>{{ pass_rate }}%</strong></span>
    <span>Generated: <strong>{{ generated_at }}</strong></span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Payload ID</th>
        <th>Category</th>
        <th>Severity</th>
        <th>Verdict</th>
        <th>Score</th>
        <th>Model Response</th>
        <th>Flags</th>
      </tr>
    </thead>
    <tbody>
      {% for r in results %}
      <tr class="{{ 'pass' if r.passed else 'fail' }}">
        <td>{{ r.payload_id }}</td>
        <td>{{ r.category }}</td>
        <td>{{ r.severity }}</td>
        <td><span class="badge {{ 'pass' if r.passed else 'fail' }}">{{ 'PASS' if r.passed else 'FAIL' }}</span></td>
        <td class="score">{{ r.score }}</td>
        <td class="response">{{ r.raw_response[:300] }}{% if r.raw_response|length > 300 %}...{% endif %}</td>
        <td>{{ r.flags | join(', ') if r.flags else 'none' }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <footer>Generated by py-prompt-injection | Phase 1</footer>
</body>
</html>